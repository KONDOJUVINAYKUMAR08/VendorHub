# Mongo root for init (used by docker)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# JWT for auth
JWT_SECRET=vendorhub-jwt-secret-2026-change-in-prod

# Internal service secret for inter-service HTTP calls
INTERNAL_SECRET=internal-service-secret-2026

# Configurable business rules (no hardcodes)
EXPIRY_WINDOW_DAYS=90
HIGH_RISK_EXPIRED_THRESHOLD=0
HIGH_RISK_REJECTED_THRESHOLD=1
HIGH_RISK_COMPLIANCE_RATIO=0.4
MEDIUM_RISK_EXPIRING_THRESHOLD=2
MEDIUM_RISK_COMPLIANCE_RATIO=0.75

# For local dev (override in .env if running services individually)
# AUTH_SERVICE_URL=http://localhost:5001
# etc.

# === Frontend Gateway (CRITICAL for Docker + EC2) ===
# The value below must be reachable from your BROWSER.
# On a fresh EC2, set it to your public IP + gateway port.
# VITE_GATEWAY_URL=http://<YOUR-EC2-PUBLIC-IP>:8080

# Example for a real EC2 public IP:
# VITE_GATEWAY_URL=http://54.123.45.67:8080

# If testing while SSH'd on the EC2 machine itself:
# VITE_GATEWAY_URL=http://localhost:8080

# Local laptop dev (frontend running outside Docker):
# VITE_GATEWAY_URL=http://localhost:8080
